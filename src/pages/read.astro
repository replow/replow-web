---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
---
<Layout title="文章 | SilverCode Nexus">
  <TwoColumnLayout showPostFooter={false}>
    <Cover slot="cover" title="文章" compact />
    <HomeSider slot="sider" />
    <article class="prose dark:prose-invert index-surface shadow-box" data-api-article-body>
      <p>正在读取文章…</p>
    </article>
  </TwoColumnLayout>
</Layout>
