---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
---
<Layout title="搜索 | SilverCode Nexus">
  <TwoColumnLayout showPostFooter={false}>
    <Cover slot="cover" title="站内搜索" compact />
    <HomeSider slot="sider" />
    <div class="index-surface shadow-box">
      <p>点击顶栏搜索按钮，搜索全部已发布文章。</p>
      <button type="button" data-replow-search class="rounded-full bg-primary px-6 py-3 text-white">搜索文章</button>
    </div>
  </TwoColumnLayout>
</Layout>
<script>
  import { openModal } from '@store/modal';
  document.addEventListener('click', (event) => {
    if ((event.target as Element)?.closest('[data-replow-search]')) openModal('search');
  });
</script>
