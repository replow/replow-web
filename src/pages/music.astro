---
import HomeSider from '@components/layout/HomeSider.astro';
import MusicPagePlayer from '@components/music/MusicPagePlayer';
import Cover from '@components/ui/cover/Cover.astro';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
---

<Layout locale={locale} title={`音乐 | ${siteConfig.title}`} description="搜索喜欢的音乐、浏览推荐歌单，在小播放器里继续聆听。" articleTools={false}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover slot="cover" title="音乐" compact />
    <HomeSider slot="sider" />
    <section class="music-page-surface bg-gradient-start shadow-box flex min-w-0 flex-col">
      <header class="music-page-header">
        <div>
          <h1>发现，喜欢的旋律。</h1>
          <p>搜索歌曲和歌手，或从推荐歌单开始。</p>
        </div>
        <span class="music-page-quality">网易云音乐</span>
      </header>
      <MusicPagePlayer client:load />
      <p class="music-page-note">音乐来自网易云音乐，实际可播放曲目以可用音源为准。</p>
    </section>
  </TwoColumnLayout>
</Layout>

<style>
  .music-page-surface {
    width: 100%;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .music-page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .music-page-header h1 {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 750;
    line-height: 1.25;
  }

  .music-page-header p {
    margin: 0.65rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .music-page-quality {
    display: inline-flex;
    align-items: center;
    margin-top: 0.25rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid hsl(var(--primary) / 0.2);
    border-radius: 999px;
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--primary));
    font-size: 0.72rem;
    font-weight: 600;
  }

  .music-page-note {
    margin: 1rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.75;
  }

  @media (max-width: 600px) {
    .music-page-surface {
      padding: 1.1rem;
    }

    .music-page-quality {
      margin-top: 0;
    }


  }
</style>
