---
import type { FriendLink } from '@constants/friends-config';
import { normalizeHexColor } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import snapshot from '@/data/replow.json';

interface Props {
  friend: FriendLink;
}

const { friend } = Astro.props;
const normalizeUrl = (url: string) => url.replace(/\/+$/, '');
const fallback = snapshot.friends.find((item) => normalizeUrl(item.website_url) === normalizeUrl(friend.url));
const latestTitle = fallback?.latest_article_title?.trim() ?? '';
const latestUrl = /^https?:\/\//i.test(fallback?.latest_article_url ?? '') ? fallback?.latest_article_url : '';
const showLatest = Boolean(latestTitle && latestUrl);
const friendDomain = (() => {
  try {
    return new URL(friend.url).hostname.replace(/^www\./i, '');
  } catch {
    return friend.url;
  }
})();
---

<article
  class="friend-card"
  style={{ '--friend-color': friend.color ? normalizeHexColor(friend.color) : 'hsl(var(--primary))' }}
>
  <a href={friend.url} target="_blank" rel="noopener noreferrer" class="friend-main">
    <span class="friend-avatar">
      <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" aria-hidden="true">
        <rect width="100" height="100" fill="hsl(var(--primary))" />
        <g fill="hsl(var(--card))">
          <circle cx="30" cy="45" r="6" />
          <circle cx="70" cy="45" r="6" />
        </g>
        <path d="M 35 65 Q 50 75 65 65" stroke="hsl(var(--card))" stroke-width="4" fill="none" stroke-linecap="round" />
        <g fill="hsl(var(--card))" opacity="0.5">
          <circle cx="20" cy="55" r="6" />
          <circle cx="80" cy="55" r="6" />
        </g>
      </svg>
      {friend.image && (
        <>
          <img data-friend-src={friend.image} alt="" width="56" height="56" loading="lazy" decoding="async" class="relative size-full object-cover" data-friend-avatar hidden />
          <noscript><img src={friend.image} alt="" width="56" height="56" loading="lazy" decoding="async" class="relative size-full object-cover" /></noscript>
        </>
      )}
    </span>
    <span class="friend-copy">
      <span class="friend-heading">
        <strong class="friend-name">{friend.site || friend.owner}</strong>
        {friend.owner?.trim() && friend.owner.trim() !== friend.site?.trim() && <span class="friend-site">{friend.owner}</span>}
      </span>
      <span class="friend-domain">{friendDomain}</span>
    </span>
    <span class="friend-arrow" aria-hidden="true">
      <Icon name="ri:arrow-right-up-line" />
    </span>
    <span class="friend-desc">{friend.desc}</span>
  </a>
  <a
    class="friend-latest"
    href={latestUrl || undefined}
    target="_blank"
    rel="noopener noreferrer"
    title={showLatest ? latestTitle : undefined}
    hidden={!showLatest}
  >
    <span class="friend-rss-icon" aria-hidden="true"><Icon name="ri:rss-line" /></span>
    <span class="friend-latest-copy">
      <span class="friend-latest-label">最新文章</span>
      <span class="friend-latest-title" data-friend-latest-title>{latestTitle}</span>
    </span>
    <Icon name="ri:arrow-right-up-line" class="friend-latest-arrow" aria-hidden="true" />
  </a>
</article>

<style is:global>
  .friend-card {
    --friend-color: hsl(var(--primary));
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 12.25rem;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid hsl(var(--border) / 0.72);
    border-radius: 1.125rem;
    background: hsl(var(--card));
    box-shadow: 0 8px 24px -18px hsl(var(--foreground) / 0.24);
    color: hsl(var(--foreground));
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .friend-card::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at 100% 0%,
      color-mix(in oklab, var(--friend-color) 15%, transparent),
      transparent 58%
    );
    content: '';
    pointer-events: none;
  }

  .friend-main {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 2rem;
    align-items: center;
    gap: 0.25rem 0.875rem;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .friend-main:hover,
  .friend-latest:hover {
    text-decoration: none;
  }

  .friend-main:focus-visible,
  .friend-latest:focus-visible {
    outline: 2px solid var(--friend-color);
    outline-offset: 3px;
  }

  .friend-avatar {
    position: relative;
    grid-row: span 2;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border: 3px solid hsl(var(--card));
    border-radius: 1rem;
    outline: 1px solid color-mix(in oklab, var(--friend-color) 52%, transparent);
    background: hsl(var(--muted));
    box-shadow: 0 5px 14px -8px color-mix(in oklab, var(--friend-color) 45%, transparent);
  }

  .friend-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friend-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }

  .friend-heading {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.4rem;
  }

  .friend-name {
    overflow: hidden;
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 200ms ease;
  }

  .friend-site {
    overflow: hidden;
    flex-shrink: 0;
    max-width: 42%;
    color: hsl(var(--muted-foreground));
    font-size: 0.6875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-domain {
    overflow: hidden;
    color: hsl(var(--muted-foreground));
    font-size: 0.6875rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 50%;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--muted) / 0.42);
    transition:
      color 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .friend-arrow svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    grid-column: 1 / -1;
    min-height: 2.5rem;
    margin-top: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.8125rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .friend-latest {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    margin-top: auto;
    padding: 0.625rem 0.75rem;
    border: 1px solid hsl(var(--border) / 0.78);
    border-radius: 0.75rem;
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.28);
    text-decoration: none;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .friend-latest[hidden] {
    display: none;
  }

  .friend-rss-icon {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    place-items: center;
    border-radius: 0.5rem;
    color: color-mix(in oklab, var(--friend-color) 80%, hsl(var(--foreground)));
    background: color-mix(in oklab, var(--friend-color) 15%, hsl(var(--card)));
  }

  .friend-rss-icon svg,
  .friend-latest-arrow {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .friend-latest-copy {
    display: flex;
    overflow: hidden;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
  }

  .friend-latest-label {
    color: hsl(var(--muted-foreground));
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .friend-latest-title {
    overflow: hidden;
    min-width: 0;
    font-size: 0.75rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-latest-arrow {
    color: hsl(var(--muted-foreground));
    transition:
      color 200ms ease,
      transform 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .friend-card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in oklab, var(--friend-color) 42%, hsl(var(--border)));
      background: color-mix(in oklab, var(--friend-color) 4%, hsl(var(--card)));
      box-shadow:
        0 14px 30px -20px color-mix(in oklab, var(--friend-color) 72%, transparent),
        inset 0 0 0 1px color-mix(in oklab, var(--friend-color) 10%, transparent);
    }

    .friend-card:hover .friend-name {
      color: color-mix(in oklab, var(--friend-color) 55%, hsl(var(--foreground)));
    }

    .friend-card:hover .friend-arrow {
      transform: translate(2px, -2px);
      border-color: color-mix(in oklab, var(--friend-color) 48%, hsl(var(--border)));
      color: hsl(var(--card));
      background: var(--friend-color);
    }

    .friend-card:hover .friend-latest {
      border-color: color-mix(in oklab, var(--friend-color) 34%, hsl(var(--border)));
      background: color-mix(in oklab, var(--friend-color) 7%, hsl(var(--muted)));
    }

    .friend-card:hover .friend-latest-arrow {
      transform: translate(2px, -2px);
      color: var(--friend-color);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card,
    .friend-avatar,
    .friend-arrow,
    .friend-latest,
    .friend-latest-arrow {
      transition-duration: 0.01ms;
    }

    .friend-card:hover {
      transform: none;
    }
  }

  @media (hover: none) and (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    html:is([data-motion='lively'], [data-motion='subtle']) .friend-card:active {
      transform: scale(0.985);
    }
  }
</style>
