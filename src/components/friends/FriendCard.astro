---
import type { FriendLink } from '@constants/friends-config';
import { normalizeHexColor } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import snapshot from '@/data/replow.json';

interface Props {
  friend: FriendLink;
}

const { friend } = Astro.props;
const normalizeUrl = (url: string) => url.replace(/\/+$/, '');
const fallback = snapshot.friends.find((item) => normalizeUrl(item.website_url) === normalizeUrl(friend.url));
const latestTitle = fallback?.latest_article_title?.trim() ?? '';
const latestUrl = /^https?:\/\//i.test(fallback?.latest_article_url ?? '') ? fallback?.latest_article_url : '';
const showLatest = Boolean(latestTitle && latestUrl);
---

<article
  class="friend-card"
  style={{ '--friend-color': friend.color ? normalizeHexColor(friend.color) : 'hsl(var(--primary))' }}
>
  <a href={friend.url} target="_blank" rel="noopener noreferrer" class="friend-main">
    <span class="friend-avatar">
      <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" aria-hidden="true">
        <rect width="100" height="100" fill="hsl(var(--primary))" />
        <g fill="hsl(var(--card))">
          <circle cx="30" cy="45" r="6" />
          <circle cx="70" cy="45" r="6" />
        </g>
        <path d="M 35 65 Q 50 75 65 65" stroke="hsl(var(--card))" stroke-width="4" fill="none" stroke-linecap="round" />
        <g fill="hsl(var(--card))" opacity="0.5">
          <circle cx="20" cy="55" r="6" />
          <circle cx="80" cy="55" r="6" />
        </g>
      </svg>
      {friend.image && (
        <>
          <img data-friend-src={friend.image} alt="" width="56" height="56" loading="lazy" decoding="async" class="relative size-full object-cover" data-friend-avatar hidden />
          <noscript><img src={friend.image} alt="" width="56" height="56" loading="lazy" decoding="async" class="relative size-full object-cover" /></noscript>
        </>
      )}
    </span>
    <span class="friend-copy">
      <span class="friend-heading">
        <strong class="friend-name">{friend.site || friend.owner}</strong>
        {friend.owner?.trim() && friend.owner.trim() !== friend.site?.trim() && <span class="friend-site">{friend.owner}</span>}
      </span>
      <span class="friend-desc">{friend.desc}</span>
    </span>
    <Icon name="ri:arrow-right-up-line" class="friend-arrow" aria-hidden="true" />
  </a>
  <a
    class="friend-latest"
    href={latestUrl || undefined}
    target="_blank"
    rel="noopener noreferrer"
    title={showLatest ? `最新文章：${latestTitle}` : undefined}
    hidden={!showLatest}
  >
    <Icon name="ri:rss-line" class="friend-rss-icon" aria-hidden="true" />
    <span class="friend-latest-label">最新文章：</span>
    <span class="friend-latest-title" data-friend-latest-title>{latestTitle}</span>
    <Icon name="ri:arrow-right-up-line" class="friend-latest-arrow" aria-hidden="true" />
  </a>
</article>

<style is:global>
  /* Each card uses the site's configured accent as a quiet signature. */
  .friend-card {
    --friend-color: hsl(var(--primary));
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    padding: 1rem 1rem 0.875rem;
    border: 1px solid hsl(var(--border) / 0.68);
    border-radius: 1.125rem;
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--friend-color) 8%, transparent), transparent 54%),
      color-mix(in oklab, hsl(var(--muted)) 28%, hsl(var(--card)));
    color: hsl(var(--foreground));
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease,
      box-shadow 220ms ease;
  }

  .friend-card::before {
    position: absolute;
    top: 0;
    left: 1.125rem;
    width: 2.5rem;
    height: 3px;
    border-radius: 0 0 999px 999px;
    background: var(--friend-color);
    content: '';
    opacity: 0.72;
  }

  .friend-main {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .friend-main:hover {
    text-decoration: none;
  }

  .friend-card:focus-within {
    border-color: color-mix(in oklab, var(--friend-color) 58%, hsl(var(--border)));
    outline: 2px solid color-mix(in oklab, var(--friend-color) 54%, transparent);
    outline-offset: 3px;
  }

  .friend-main:focus-visible,
  .friend-latest:focus-visible {
    border-radius: 0.5rem;
    outline: none;
  }

  .friend-latest {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid hsl(var(--border) / 0.65);
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .friend-latest[hidden] {
    display: none;
  }

  .friend-latest:hover {
    color: color-mix(in oklab, var(--friend-color) 68%, hsl(var(--foreground)));
    text-decoration: none;
  }

  .friend-rss-icon {
    box-sizing: content-box;
    width: 0.875rem;
    height: 0.875rem;
    flex: 0 0 auto;
    padding: 0.2rem;
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--friend-color) 12%, hsl(var(--card)));
    color: color-mix(in oklab, var(--friend-color) 72%, hsl(var(--foreground)));
  }

  .friend-latest-arrow {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    margin-left: auto;
    opacity: 0.55;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .friend-latest-label {
    flex: 0 0 auto;
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .friend-latest-title {
    overflow: hidden;
    min-width: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-avatar {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    flex: 0 0 auto;
    overflow: hidden;
    border: 1px solid hsl(var(--card) / 0.85);
    border-radius: 1.05rem;
    background: hsl(var(--card));
    box-shadow: 0 3px 12px -7px hsl(var(--foreground) / 0.5);
  }

  .friend-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friend-avatar img[hidden] {
    display: none;
  }

  .friend-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
  }

  .friend-heading {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    padding-right: 1.25rem;
  }

  .friend-name {
    overflow: hidden;
    min-width: 0;
    flex: 0 1 auto;
    max-width: 72%;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 200ms ease;
  }

  .friend-site {
    overflow: hidden;
    min-width: 0;
    max-width: 42%;
    padding: 0.125rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in oklab, hsl(var(--muted)) 62%, hsl(var(--card)));
    color: hsl(var(--muted-foreground));
    font-size: 0.6875rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-desc {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .friend-arrow {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 1rem;
    height: 1rem;
    padding: 0.2rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--friend-color) 9%, hsl(var(--card)));
    color: color-mix(in oklab, var(--friend-color) 72%, hsl(var(--foreground)));
    opacity: 0.72;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .friend-card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in oklab, var(--friend-color) 46%, hsl(var(--border)));
      background:
        linear-gradient(135deg, color-mix(in oklab, var(--friend-color) 12%, transparent), transparent 58%),
        color-mix(in oklab, var(--friend-color) 4%, hsl(var(--card)));
      box-shadow: 0 14px 28px -20px color-mix(in oklab, var(--friend-color) 88%, hsl(var(--foreground)));
    }

    .friend-card:hover .friend-name {
      color: color-mix(in oklab, var(--friend-color) 65%, hsl(var(--foreground)));
    }

    html:not(.dark) .friend-card:hover .friend-name {
      color: color-mix(in oklab, var(--friend-color) 35%, hsl(var(--foreground)));
    }

    .friend-card:hover .friend-arrow {
      opacity: 1;
      transform: translate(2px, -2px);
    }

    .friend-card:hover .friend-latest-arrow {
      opacity: 1;
      transform: translateX(2px);
    }

    @media (prefers-reduced-motion: no-preference) {
      html:not([data-motion='reduced']) .friend-card:hover .friend-avatar {
        transform: scale(1.035);
        transition: transform 220ms ease;
      }
    }
  }

  @media (hover: none) and (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    html:is([data-motion='lively'], [data-motion='subtle']) .friend-card {
      transition: transform 180ms ease-out;
    }

    html:is([data-motion='lively'], [data-motion='subtle']) .friend-card:active {
      transform: scale(0.98);
    }
  }
</style>
