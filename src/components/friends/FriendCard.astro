---
import type { FriendLink } from '@constants/friends-config';
import { normalizeFriendHostname, renderFriendCardMarkup } from '@lib/replow/friend-card';
import snapshot from '@/data/replow.json';

interface Props {
  friend: FriendLink;
  id: string;
}

const { friend, id } = Astro.props;
const snapshotFriend = snapshot.friends.find(
  (item) => normalizeFriendHostname(item.website_url) === normalizeFriendHostname(friend.url),
);
const markup = renderFriendCardMarkup({
  id,
  name: friend.site || friend.owner,
  websiteUrl: friend.url,
  description: friend.desc,
  avatarUrl: friend.image,
  color: friend.color,
  latestArticleTitle: snapshotFriend?.latest_article_title,
  latestArticleUrl: snapshotFriend?.latest_article_url,
});
---

<Fragment set:html={markup} />
