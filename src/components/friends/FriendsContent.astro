---
import PageIntro from '@components/common/PageIntro.astro';
import FriendsGrid from '@components/friends/FriendsGrid.astro';
import SiteInfoCard from '@components/friends/SiteInfoCard.astro';
import { friendsData } from '@constants/friends-config';
import { Comment } from '@/components/comment';
import FriendRequestForm from '@/components/replow/FriendApplication.astro';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
---

<div class="index-surface shadow-box flex flex-col gap-8">
  <PageIntro className="page-intro-flush" stats={[{ value: friendsData.length, label: t(locale, 'friends.countUnit') }]} />
  <SiteInfoCard />
  <FriendsGrid locale={locale} />
  <div class="mb-4">
    <FriendRequestForm />
    <Comment />
  </div>
</div>
