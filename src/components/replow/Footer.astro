---
import sanitizeHtml from 'sanitize-html';
import snapshot from '@/data/replow.json';

interface Props {
  className?: string;
}
const { className } = Astro.props;
const config = snapshot.firefly.footerConfig;
const html = sanitizeHtml(config.customHtml || '', {
  allowedTags: ['span', 'a', 'i', 'time', 'nav', 'br', 'strong'],
  allowedAttributes: {
    '*': [
      'class',
      'aria-hidden',
      'aria-label',
      'data-runtime-profile-name',
      'data-footer-year',
      'data-site-uptime',
      'data-start',
    ],
    a: ['href', 'target', 'rel'],
  },
});
---
<footer class:list={['replow-footer', className]} hidden={config.enable === false} data-runtime-footer>
  <div data-runtime-footer-content set:html={html} />
  <a class="source-link" href="https://github.com/cosZone/astro-koharu" target="_blank" rel="noopener noreferrer">astro-koharu</a>
  <a class="source-link" href="/source/astro-koharu-replow.tar.gz">主题源码</a>
</footer>
<style is:global>
  .replow-footer { margin-top: auto; padding: 2rem 1rem; text-align: center; color: hsl(var(--muted-foreground)); font-size: .82rem; line-height: 1.8; }
  .replow-footer .footer-line { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .5rem; }
  .replow-footer .footer-version-line { font-size: .94rem; }
  .replow-footer .footer-version-brand { font-weight: 700; color: hsl(var(--primary)); }
  .replow-footer .footer-legal-gap { height: .65rem; }
  .replow-footer i { font-style: normal; opacity: .45; }
  .replow-footer a:hover { color: hsl(var(--primary)); }
  .source-link { font-size: .7rem; opacity: .55; }
  [hidden] { display: none !important; }
  #site-header.replow-scrolling, #mobile-menu-container.replow-scrolling { transform: translateY(-110%) !important; }
  #site-header, #mobile-menu-container { transition: transform .3s cubic-bezier(.22,1,.36,1); }
  @media (prefers-reduced-motion: reduce) { #site-header, #mobile-menu-container { transition: none; } }
</style>
