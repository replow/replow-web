---
interface Props {
  mode?: 'search' | 'confirm';
}
const { mode = 'search' } = Astro.props;
---
<section class="index-surface shadow-box fq-surface">
  <div class="fq-page-heading">
    <div><span class="fq-eyebrow">SILUNE · READING TOOLS</span><h2>{mode === 'confirm' ? '确认下载' : '番茄小说下载器'}</h2><p>{mode === 'confirm' ? '确认书籍，选择想带走的章节。' : '寻找一本好书，让故事陪你走得更远。'}</p></div>
    <a class="fq-history-link" href="https://account.replow.org/?section=downloads" data-astro-reload><span aria-hidden="true">◷</span> 历史下载 <span aria-hidden="true">↗</span></a>
  </div>
  <ol class="fq-steps" aria-label="下载步骤">
    <li class:list={{current:mode==='search'}}><span>01</span> 寻找书籍</li>
    <li class:list={{current:mode==='confirm'}}><span>02</span> 选择章节与格式</li>
    <li><span>03</span> 保存你的故事</li>
  </ol>
  <div class="fq-app" data-fanqie={mode}><p>正在确认登录状态…</p></div>
</section>
<script>
  import { startFanqie } from '@/lib/replow/fanqie';
  if (document.readyState !== 'loading') startFanqie();
  else document.addEventListener('DOMContentLoaded', startFanqie, { once: true });
  document.addEventListener('astro:page-load', startFanqie);
</script>
<style>
  .fq-surface{padding:clamp(18px,3vw,36px);min-width:0}
  .fq-page-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:24px}
  .fq-page-heading h2{font-size:clamp(24px,3vw,32px);font-weight:750;margin:5px 0 10px;letter-spacing:-.03em}
  .fq-page-heading p,.fq-history-link{color:hsl(var(--muted-foreground));font-size:14px}
  .fq-history-link{display:flex;align-items:center;gap:7px;padding:9px 14px;border:1px solid hsl(var(--border));border-radius:999px;white-space:nowrap;transition:color 180ms,border-color 180ms}
  .fq-history-link:hover{color:hsl(var(--primary));border-color:hsl(var(--primary)/.4)}
  .fq-eyebrow{font-size:10px;letter-spacing:.2em;color:hsl(var(--badge-primary));font-weight:700}
  .fq-steps{display:flex;gap:24px;flex-wrap:wrap;margin:0 0 28px;padding:16px 0;border-block:1px solid hsl(var(--border)/.7);list-style:none;color:hsl(var(--muted-foreground));font-size:12px}
  .fq-steps li{display:flex;gap:8px;align-items:center}.fq-steps li>span{font-size:10px;font-variant-numeric:tabular-nums;opacity:.65}
  .fq-steps .current{color:hsl(var(--badge-primary));font-weight:650}.fq-steps .current>span{opacity:1}
  @media(max-width:600px){.fq-steps{gap:12px;font-size:11px;margin-bottom:22px}.fq-steps li{gap:5px}.fq-page-heading{gap:12px}.fq-history-link{padding:7px 11px;font-size:12px}}
</style>
