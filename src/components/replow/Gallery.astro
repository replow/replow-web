---
import snapshot from '@/data/gallery.json';
import { imageUrl, normalizeAlbums } from '@/lib/replow/gallery/data';

const albums = normalizeAlbums(snapshot.items);
---
<section class="index-surface shadow-box gallery-surface" data-gallery>
 <div class="gallery-toolbar"><div><h2 data-gallery-title>相册</h2><p data-gallery-description>收集日常、风景与值得留下的瞬间。</p></div><div class="gallery-actions"><button type="button" data-gallery-back hidden>← 全部相册</button><button type="button" data-gallery-refresh>刷新相册</button></div></div>
 <p class="gallery-status" role="status" aria-live="polite" data-gallery-status></p>
 <div class="gallery-albums" data-gallery-list>{albums.map(album=><a class="gallery-album" href={'?album='+album.id} data-album={album.id}>{album.resolved_cover?<img src={imageUrl(album.resolved_cover)} alt="" loading="lazy"/>:<span class="gallery-placeholder">还没有封面</span>}<div class="gallery-album-info"><h3>{album.title}</h3><p>{album.description}</p><small>{album.photo_count} 张图片</small></div></a>)}{!albums.length&&<p class="gallery-empty">相册正在整理中，新的瞬间很快就会出现。</p>}</div>
 <dialog class="gallery-lightbox" aria-label="图片大图浏览">
  <div class="lightbox-toolbar"><span data-lightbox-counter></span><button type="button" aria-label="关闭大图" data-lightbox-close>关闭 ×</button></div>
  <div class="lightbox-stage"><button type="button" aria-label="上一张图片" data-lightbox-prev>‹</button><img alt="" data-lightbox-image/><button type="button" aria-label="下一张图片" data-lightbox-next>›</button></div>
  <p data-lightbox-caption></p><small>方向键 / 左右滑动切换 · Esc 关闭</small>
 </dialog>
</section>
<script>
 import { startGallery,stopGallery } from '@/lib/replow/gallery/client';
 if(document.readyState!=='loading')startGallery();
 else document.addEventListener('DOMContentLoaded',startGallery,{once:true});
 document.addEventListener('astro:page-load',startGallery);
 document.addEventListener('astro:before-swap',stopGallery);
</script>
<style is:global>
.gallery-surface{padding:clamp(18px,3vw,32px);min-width:0}.gallery-toolbar{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;flex-wrap:wrap}.gallery-toolbar h2{font-size:1.5rem;font-weight:700;margin-bottom:8px}.gallery-toolbar p,.gallery-status,.gallery-album-info p,.gallery-album-info small{color:hsl(var(--muted-foreground))}.gallery-actions{display:flex;gap:10px;flex-wrap:wrap}.gallery-actions button{border:1px solid hsl(var(--border));border-radius:12px;padding:9px 14px;background:hsl(var(--background));cursor:pointer}.gallery-actions button:hover{color:hsl(var(--primary));border-color:hsl(var(--primary))}.gallery-status{font-size:.85rem;margin:16px 0;min-height:1.4em}.gallery-albums{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:22px}.gallery-album{border:1px solid hsl(var(--border));border-radius:18px;overflow:hidden;transition:transform .2s ease;background:hsl(var(--background))}.gallery-album:hover{transform:translateY(-4px)}.gallery-album>img,.gallery-placeholder{display:block;width:100%;height:180px;object-fit:cover;background:hsl(var(--muted))}.gallery-placeholder{display:grid;place-items:center;color:hsl(var(--muted-foreground));font-size:.9rem}.gallery-album-info{padding:18px}.gallery-album-info h3{font-size:1.1rem;font-weight:650}.gallery-album-info p{font-size:.9rem;margin:8px 0;white-space:pre-wrap;overflow-wrap:anywhere}.gallery-album-info small{font-size:.8rem}.gallery-photos{columns:3 210px;column-gap:16px}.gallery-photo{display:block;width:100%;margin:0 0 16px;break-inside:avoid;border-radius:14px;overflow:hidden;text-align:left;background:hsl(var(--muted));cursor:zoom-in}.gallery-photo img{width:100%;height:auto;display:block}.gallery-photo span{display:block;padding:12px 14px;font-size:.88rem;white-space:pre-wrap;overflow-wrap:anywhere}.gallery-empty{padding:36px 8px;color:hsl(var(--muted-foreground));grid-column:1/-1;column-span:all}.gallery-lightbox{width:min(96vw,1400px);max-width:96vw;height:auto;max-height:96dvh;margin:auto;border:1px solid #ffffff28;border-radius:18px;background:#101018;color:#f6f2ff;padding:16px;overflow:auto}.gallery-lightbox::backdrop{background:#05040be8;backdrop-filter:blur(8px)}.lightbox-toolbar{display:flex;justify-content:space-between;align-items:center;padding:0 2px 14px}.lightbox-toolbar button{padding:8px 14px;border-radius:8px;background:#ffffff18;cursor:pointer}.lightbox-stage{display:flex;align-items:center;justify-content:space-between;gap:12px}.lightbox-stage img{max-width:calc(100% - 100px);max-height:73dvh;object-fit:contain;touch-action:pan-y;user-select:none}.lightbox-stage button{width:38px;min-width:38px;height:48px;font-size:32px;background:#ffffff18;border-radius:10px;cursor:pointer}.gallery-lightbox p{white-space:pre-wrap;overflow-wrap:anywhere;text-align:center;margin-top:14px}.gallery-lightbox>small{display:block;text-align:center;color:#b9afc9;margin-top:8px;font-size:.75rem}.gallery-surface button:focus-visible,.gallery-surface a:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:3px}@media(max-width:600px){.gallery-albums{grid-template-columns:1fr}.gallery-photos{columns:2;column-gap:10px}.gallery-photo{margin-bottom:10px;border-radius:10px}.gallery-photo span{padding:8px;font-size:.8rem}.gallery-lightbox{padding:12px 8px}.lightbox-stage{gap:6px}.lightbox-stage img{max-width:calc(100% - 68px);max-height:70dvh}.lightbox-stage button{width:28px;min-width:28px;height:44px}}
@media(prefers-reduced-motion:reduce){.gallery-album{transition:none}.gallery-album:hover{transform:none}}
</style>
