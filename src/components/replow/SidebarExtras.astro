---
import { buildCategoryPath, getAllTags, getCategoryList, getSortedPosts } from '@lib/content';
import snapshot from '@/data/replow.json';
import { getLocaleFromUrl } from '@/i18n';
import Calendar from './Calendar.astro';

const locale = getLocaleFromUrl(Astro.url.pathname);
const posts = await getSortedPosts(locale);
const { countMap } = await getCategoryList(locale);
const tags = Object.entries(getAllTags(posts));
---
<div class="replow-sidebar-extras">
  <section>
    <h3>分类</h3>
    <div class="sidebar-chips">{Object.entries(countMap).map(([name, count]) => <a href={buildCategoryPath(name.split('/'))}>{name}<small>{count}</small></a>)}</div>
  </section>
  <section>
    <h3>标签</h3>
    <div class="sidebar-chips">{tags.map(([name, count]) => <a href={'/tags/' + encodeURIComponent(name) + '/'}>{name}<small>{count}</small></a>)}</div>
  </section>
  <section>
    <h3>最近动态</h3>
    <div data-recent-dynamics><a class="sidebar-dynamic" href="/dynamic/">查看最新动态 →</a></div>
  </section>
  <section class="sidebar-counts"><span>{snapshot.stats.published_articles} 篇文章</span><span>{snapshot.stats.comments} 条评论</span><span>{snapshot.stats.friends} 个友链</span></section>
  <Calendar dates={posts.map((post) => post.data.date.toISOString().slice(0, 10))} />
</div>
<style>
  .replow-sidebar-extras { padding:0 .5rem 1rem; }
  section { margin:1rem 0; }
  h3 { color:hsl(var(--primary)); font-size:.85rem; font-weight:700; margin-bottom:.6rem; }
  .sidebar-chips { display:flex; flex-wrap:wrap; gap:.4rem; font-size:.72rem; }
  .sidebar-chips a { border:1px solid hsl(var(--primary)/.15); padding:.2rem .5rem; border-radius:1rem; }
  small { margin-left:.3rem; opacity:.6; }
  :global(.replow-sidebar-extras .sidebar-dynamic) { display:flex; flex-direction:column; gap:.25rem; margin-bottom:.5rem; font-size:.8rem; }
  :global(.replow-sidebar-extras .sidebar-dynamic time) { font-size:.68rem; opacity:.6; }
  .sidebar-counts { display:flex; flex-wrap:wrap; gap:.7rem; font-size:.72rem; color:hsl(var(--muted-foreground)); }
</style>

<script>
  import { startRecentDynamics, stopRecentDynamics } from '@/lib/replow/dynamics/sidebar';
  if (document.readyState !== 'loading') startRecentDynamics();
  else document.addEventListener('DOMContentLoaded', startRecentDynamics, {once:true});
  document.addEventListener('astro:page-load', startRecentDynamics);
  document.addEventListener('astro:before-swap', stopRecentDynamics);
</script>
