[Unit]
Description=Deploy verified Silune preview GitHub release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agentdock
Group=agentdock
WorkingDirectory=/data/replow-preview
ExecStart=/usr/bin/python3 /data/replow-preview/preview-release-deploy.py
TimeoutStartSec=900
