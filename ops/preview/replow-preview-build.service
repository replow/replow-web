[Unit]
Description=Build and atomically publish isolated Silune preview
After=network.target replow-preview-api.service
[Service]
Type=oneshot
User=agentdock
Group=agentdock
WorkingDirectory=/data/replow-preview/source/www
ExecStart=/usr/bin/python3 /data/replow-preview/preview-worker.py
ExecStopPost=/usr/bin/python3 /data/replow-preview/preview-worker.py --finalize
Environment=PATH=/data/replow-next/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=45min
MemoryMax=480M
MemorySwapMax=2200M
CPUQuota=70%
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/replow-preview
